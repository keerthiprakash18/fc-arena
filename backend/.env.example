# ── Django ───────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
# Comma-separated hostnames, e.g. api.fcarena.com,localhost
ALLOWED_HOSTS=api.fcarena.com,127.0.0.1

# ── CORS ─────────────────────────────────────────────────────────────────
# Allow every origin in dev; in production list your web origins.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://fcarena.com,https://app.fcarena.com

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_NAME=fc_arena_db
DATABASE_USER=fc_arena_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ── HTTPS hardening (used only when DEBUG=False) ─────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ── Match verification / OCR ─────────────────────────────────────────────
# local   = Windows Media OCR (free, dev only - NOT available on Linux hosts)
# experiential = paid AI API (uses credits)
# auto    = try experiential first, fall back to local
# NOTE: on Render/Railway (Linux) no winrt OCR exists, so verification
#       automatically falls back to manual admin review.
OCR_PROVIDER=local

# Experiential AI (paid, optional) - leave empty to disable
EXPLABS_API_KEY=
EXPLABS_BASE_URL=
EXPLABS_MODEL=